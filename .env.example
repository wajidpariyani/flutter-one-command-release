# =============================================================================
# Copy to .env and fill in. .env is gitignored — secrets live ONLY there.
# The defaults below are enough for ./scripts/build_prod.sh --dry-run
# =============================================================================

# ---- App -----------------------------------------------------------------
APP_NAME=builddemo
ARTIFACT_DIR=dist
# Optional branch guards (leave empty to skip the check)
DEV_BRANCH=
PROD_BRANCH=

# ---- Android signing (dummy values work with create_dummy_keystore.sh) ----
ANDROID_KEYSTORE_PATH=android/dummy-release.jks
ANDROID_KEYSTORE_PASSWORD=change-me-demo-only
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=change-me-demo-only

# ---- Google Play upload (real uploads only) -------------------------------
ANDROID_PACKAGE_NAME=com.example.builddemo
PLAY_JSON_KEY_PATH=

# ---- App Store Connect upload (real uploads only) -------------------------
IOS_BUNDLE_ID=com.example.builddemo
# App Store Connect > Users and Access > Integrations > App Store Connect API
ASC_KEY_ID=
ASC_ISSUER_ID=
# ExportOptions plist for a signed App Store .ipa (method: app-store-connect)
IOS_EXPORT_OPTIONS_PLIST=

# ---- Dev distribution (Firebase App Distribution, free) -------------------
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
# ExportOptions plist for a signed ad-hoc .ipa (method: release-testing)
IOS_DEV_EXPORT_OPTIONS_PLIST=

# ---- Notifications (optional, free) ---------------------------------------
# Discord or Slack incoming-webhook URL. Leave empty to skip.
NOTIFY_WEBHOOK_URL=
